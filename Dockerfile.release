# Release image for prism (agent): copies the GoReleaser-built CGO binary onto
# debian:trixie-slim. The agent ships checkpointed .duckdb log/metrics windows
# via go-duckdb, so the runtime base must provide glibc ≥ 2.38 + libstdc++6
# (same floor as prism-store; bookworm-slim 2.36 is too old for the release
# runner's glibc). Process runs as uid 65532.
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
COPY prism /usr/local/bin/prism
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/prism"]
CMD ["run", "-config", "/etc/prism/prism.yaml"]
