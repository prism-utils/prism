# Release image for prism (agent): copies the GoReleaser-built CGO binary onto
# debian:trixie-slim. The agent ships checkpointed .duckdb log/metrics windows
# via go-duckdb, so the runtime base must provide glibc ≥ 2.38 + libstdc++6
# (same floor as prism-store; bookworm-slim 2.36 is too old for the release
# runner's glibc). Process runs as uid 65532.
FROM debian:trixie-slim
# libblkid1 2.41-5 is CVE-2026-53615 HIGH; trixie-security ships 2.41.5-0+deb13u1.
RUN set -eux; \
    if ! grep -Rqs trixie-security /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then \
      echo 'deb http://deb.debian.org/debian-security trixie-security main' > /etc/apt/sources.list.d/debian-security.list; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates libstdc++6 libblkid1; \
    apt-get upgrade -y; \
    rm -rf /var/lib/apt/lists/*
COPY prism /usr/local/bin/prism
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/prism"]
CMD ["run", "-config", "/etc/prism/prism.yaml"]
