# Source-building store image for local/e2e use: compiles prism-store with CGO
# (DuckDB) inside a linux builder so the image runs on any host arch without a
# darwin↔linux cross-compile. The release pipeline still uses
# Dockerfile.store.release with a GoReleaser-built binary; this variant exists so
# `make promql-e2e` can stand up a real store from source.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
ARG VERSION=e2e
ENV CGO_ENABLED=1
RUN go build -tags duckdb_arrow -trimpath \
    -ldflags "-s -w -X github.com/prism-utils/prism/internal/version.Version=${VERSION}" \
    -o /out/prism-store ./cmd/prism-store

# Runtime shares the builder's glibc (bookworm, 2.36) and adds libstdc++ for
# DuckDB plus wget for the compose healthcheck.
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libstdc++6 wget \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/prism-store /usr/local/bin/prism-store
RUN mkdir -p /data && chown 472:472 /data
USER 472:472
ENTRYPOINT ["/usr/local/bin/prism-store"]
